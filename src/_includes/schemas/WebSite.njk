<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": {{ (meta.url ~ "/#website") | dump | safe }},
        "url": {{ (meta.url ~ "/") | dump | safe }},
        "name": {{ meta.siteName | dump | safe }},
        "description": {{ meta.siteDescription | dump | safe }},
        "inLanguage": {{ meta.lang | dump | safe }},
        "publisher": { "@id": "https://aila.ngo/#organization" }
      },
      {% include "schemas/Organization.njk" %}
    ]
  }
</script>
