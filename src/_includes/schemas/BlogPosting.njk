<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ (meta.url ~ page.url ~ "#article") | dump | safe }},
    "url": {{ (meta.url ~ page.url) | dump | safe }},
    "mainEntityOfPage": {{ (meta.url ~ page.url) | dump | safe }},
    "isPartOf": { "@id": {{ (meta.url ~ "/#website") | dump | safe }} },
    "headline": {{ (title or meta.siteName) | dump | safe }},
    "description": {{ (discover.description or description or meta.siteDescription) | dump | safe }},
    "image": {{ (meta.url ~ (("/assets/images/" ~ discover.image) if discover.image else meta.opengraph_default)) | dump | safe }},
    "inLanguage": {{ meta.lang | dump | safe }},
    "publisher": { "@id": "https://aila.ngo/#organization" },
    "author": { "@id": "https://aila.ngo/#organization" },
    "datePublished": {{ (date | toIsoString) | dump | safe }}
  }
</script>
